# ── NYC Airbnb Polyglot Analytics Platform — Environment Variables ────────────
# Copy this file to .env at the repo root and fill in the API keys section.
# Everything else is pre-configured to match the Docker init scripts.
# NEVER commit .env to version control.

# ── API Keys — fill these in ──────────────────────────────────────────────────
# Google Places API (ingestion — fetch_places.py)
# → https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Socrata app token (ingestion — fetch_noise_complaints.py)
# → https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=your_socrata_app_token_here

# Groq API key (agent — free tier, fast inference)
# → https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── PostgreSQL — pre-configured, no changes needed ────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airbnb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Read-only user created by docker/postgres/01_readonly_role.sql on first start
POSTGRES_RO_USER=airbnb_readonly
POSTGRES_RO_PASSWORD=airbnb_readonly_pass

# ── MongoDB — pre-configured, no changes needed ───────────────────────────────
MONGO_URI=mongodb://mongo_root:mongo_root_pass@localhost:27017
MONGO_DB=airbnb_geo
# Read-only user created by docker/mongodb/01_readonly_user.js on first start
MONGO_RO_URI=mongodb://airbnb_readonly:airbnb_readonly_pass@localhost:27017

# ── ChromaDB — pre-configured, no changes needed ─────────────────────────────
CHROMA_PATH=data_pipeline/processed/chromadb

# ── Ollama (fallback — only if no GROQ_API_KEY) ───────────────────────────────
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ── Evaluation judge — optional, only for evaluate_agent.py ──────────────────
# GPT-4o-mini via OpenAI API — not required to run the agent.
# → https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
