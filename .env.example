# ── NYC Airbnb Hospitality Lakehouse — Environment Variables ──────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── PostgreSQL (admin — used by transformation scripts only) ──────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airbnb
POSTGRES_USER=airbnb_admin
POSTGRES_PASSWORD=change_me

# ── PostgreSQL (read-only — used by MCP server / agent) ───────────────────────
# Principle of least privilege: the query layer cannot write or drop tables.
POSTGRES_RO_USER=airbnb_readonly
POSTGRES_RO_PASSWORD=change_me_readonly

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://airbnb_admin:change_me@localhost:27017
MONGO_DB=airbnb_geo
# Read-only user for MCP server
MONGO_RO_URI=mongodb://airbnb_readonly:change_me_readonly@localhost:27017

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PATH=data_pipeline/processed/chromadb

# ── Ingestion API keys ────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
SOCRATA_APP_TOKEN=your_socrata_app_token_here

# ── Optional ──────────────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
